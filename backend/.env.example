# Copy to backend/.env and fill in. Field names match app/config.py (case-insensitive).

# Railway's EXTERNAL database URL. The internal DATABASE_URL is service-to-service only.
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
ANTHROPIC_API_KEY=sk-ant-...

# development keeps the auth cookie non-secure so localhost works; anything else sets secure.
ENVIRONMENT=development

# Optional. Defaults to config.py's default_model. See README, "Choosing the Model".
# DEFAULT_MODEL=claude-opus-4-6
