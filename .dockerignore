# this file says what not to ship (different from .gitignore = what not to track)
# there is no way to `include .gititnore` in .dockerignore programatically
# and .dockerignore patterns != .gitignore patterns

# .dockerignore patterns match relative to the build context root,
# and a bare name matches ONLY at the root. Use **/ for "at any depth"

# Everything git ignores should be covered here. Check with:
#   python3 scripts/check_docker_context.py --probe

# secrets
**/.env
**/.env.*
# private prompts (ADR-013). To ship prompt files in the image, change this and .gitignore together.
**/prompts

# for the Dev / docs
**/DEVLOG
test-vehicles
docs
README.md

# compressed caches
.git
**/*.zip

# venv
# Both rules stay, whatever happens to the comment: `COPY backend/ .` would otherwise copy a
# host venv into the image -- a macOS venv into a Linux one, or a second venv over the image's
# own. `check_docker_context.py --probe` is the net that catches it.
# [SPRINT-13-CLEANUP] The coexistence this note used to describe is over: the old pip venv
# backend/venv was deleted 2026-09-17, and backend/.venv now comes from `uv sync`. 13b deletes
# this marker and the note -- not the two rules. See remaining-sprints.md, Sprint 13b.
**/.venv
**/venv

# tests
backend/tests
frontend/src/__tests__

# Frontend source (only needed for build)
frontend/**/node_modules
frontend/.vite
frontend/**/dist-ssr
frontend/**/*.local

# build output (**/dist also covers frontend/dist)
**/dist
**/build
**/*.egg-info
**/*.egg
**/*.whl
**/*.so

# Python caches
**/.mypy_cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]
**/*$py.class

# test coverage and local Postgres
**/.coverage
**/htmlcov
**/pgdata
**/*.sql.bak

# logs and generated documents (tailored resumes)
**/*.log
frontend/**/logs
frontend/**/npm-debug.log*
frontend/**/yarn-debug.log*
frontend/**/yarn-error.log*
frontend/**/pnpm-debug.log*
frontend/**/lerna-debug.log*
**/*.docx

# Editor/OS junk
**/.vscode
**/.idea
**/.claude
**/.DS_Store
**/*.sw?
**/*~
**/Thumbs.db
frontend/**/*.suo
frontend/**/*.ntvs*
frontend/**/*.njsproj
frontend/**/*.sln
