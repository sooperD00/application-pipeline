# this file says what not to ship (different from .gitignore = what not to track)
# there is no way to `include .gititnore` in .dockerignore programatically
# and .dockerignore patterns != .gitignore patterns

# .dockerignore patterns match relative to the build context root,
# and a bare name matches ONLY at the root. Use **/ for "at any depth"

# Everything git ignores should be covered here. Check with:
#   python3 test-vehicles/dockerignore-check/check_docker_context.py --probe

# secrets
**/.env
**/.env.*
# private prompts (ADR-013). To ship prompt files in the image, change this and .gitignore together.
**/prompts

# for the Dev / docs
**/DEVLOG
test-vehicles
docs
README.md

# compressed caches
.git
**/*.zip

# venv
# [SPRINT-13-CLEANUP] backend/.venv is created by `uv sync` in Sprint 13a and coexists with
# the old backend/venv while requirements.txt is still the Docker consumer. Resolved in 13b,
# when the Dockerfile installs from uv.lock. See remaining-sprints.md, Sprint 13a commit 3.
**/.venv
**/venv

# tests
backend/tests
frontend/src/__tests__

# Frontend source (only needed for build)
frontend/**/node_modules
frontend/.vite
frontend/**/dist-ssr
frontend/**/*.local

# build output (**/dist also covers frontend/dist)
**/dist
**/build
**/*.egg-info
**/*.egg
**/*.whl
**/*.so

# Python caches
**/.mypy_cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]
**/*$py.class

# test coverage and local Postgres
**/.coverage
**/htmlcov
**/pgdata
**/*.sql.bak

# logs and generated documents (tailored resumes)
**/*.log
frontend/**/logs
frontend/**/npm-debug.log*
frontend/**/yarn-debug.log*
frontend/**/yarn-error.log*
frontend/**/pnpm-debug.log*
frontend/**/lerna-debug.log*
**/*.docx

# Editor/OS junk
**/.vscode
**/.idea
**/.claude
**/.DS_Store
**/*.sw?
**/*~
**/Thumbs.db
frontend/**/*.suo
frontend/**/*.ntvs*
frontend/**/*.njsproj
frontend/**/*.sln
