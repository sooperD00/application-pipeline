      "isDeleted": false,
      "boundElements": null,
      "updated": 1785173420995,
      "link": null,
      "locked": false,
      "text": "don't overwhelm them... prioritize the most important questions\nto ask in numerical order at least in the background, but also let\nthem choose what's easiest (least friction, etc) for them\ndepending how horrible the original content was.\n\nLet the user rescore after a minimum amount of \"new data\" that\nthey entered (somehow decide this), and also auto-rescore or\nstrongly nudge a rescore, or SSE stream the rescore in the\nbackground after a larger \"probably going to get a good bump\"\namount.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "don't overwhelm them... prioritize the most important questions to ask in numerical order at least in the background, but also let them choose what's easiest (least friction, etc) for them depending how horrible the original content was.\n\nLet the user rescore after a minimum amount of \"new data\" that they entered (somehow decide this), and also auto-rescore or strongly nudge a rescore, or SSE stream the rescore in the background after a larger \"probably going to get a good bump\" amount.",
      "autoResize": false,
      "lineHeight": 1.25
    },
